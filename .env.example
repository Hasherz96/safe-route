# GEMINI_API_KEY: Required for Gemini AI API calls with Google Search Grounding.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps JavaScript SDK and Places API (New).
# Locally it is built into the front end. In a deployed container, set it (or
# GOOGLE_MAPS_API_KEY) as a runtime environment variable; the server passes it
# to the browser through /api/config.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# PORT: Port the server listens on (default 3000). Cloud Run sets this automatically.
# PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
